node_modules
.next
next-env.d.ts
*.tsbuildinfo
.DS_Store

# Secrets. The Discord OAuth pair, the feedback webhook, the database URL.
.env*.local

# Local-only
.claude/settings.local.json
.scratch/

# Where the doll build scripts unpack the archives before converting.
.doll-tmp/

# The client's own patched DBC tables, lifted by dbc112() in
# scripts/client.mjs. Blizzard's data; re-extracted on demand.
.dbc-112/

# pfQuest's lua tables, pulled by scripts/map-pins.py. Somebody else's MIT
# repo; re-fetched on demand. Delete the folder to take a newer cut.
.pf-cache/

# Where scripts/map-plates-client.py unpacks the client's map tiles before
# compositing them. Blizzard's art; re-extracted on demand.
.map-tmp/

# The wardrobe: 106 MB of Blizzard's item art across 12,459 files, rebuilt by
# `node scripts/doll-items.mjs` from a local 1.12 client and served in
# production out of a second repo on GitHub Pages, which
# `scripts/doll-publish.mjs` pushes. Out of *this* repo for two reasons:
# docs/TARI.md §7.1 on putting their work in front of users, and a hard one —
# Vercel fails a build above 15,000 files and the repo plus this art comes
# to 16,712.
#
# catalogue.json is the exception and stays tracked. It is one file, the CDN
# compresses it to about 200 KB for free, and it belongs beside the code that
# reads it.
public/lab/doll/items/m2/
public/lab/doll/items/tex/
public/lab/doll/items/icons/

# The unstripped bodies, 47 MB across sixteen files. `doll-build.mjs` writes
# them here from a local 1.12 client and `doll-strip.mjs` turns them into
# public/lab/doll/body/*.tbody — 3 MB, tracked, and the only thing the
# browser ever fetches. Keeping the raw .m2 out of git keeps 44 MB out of
# every clone and stops Vercel deploying files nothing requests.
#
#   git rm -r --cached public/lab/doll/m2      (once, to untrack them)
public/lab/doll/m2/

# The succubus who holds the landing page's curtain, same rule again: the
# 660 KB unstripped .m2 is the source `scripts/succubus-build.mjs` reads, and
# public/lab/succubus/Succubus.tbody — 141 KB, tracked — is the only geometry
# a browser ever fetches.
public/lab/succubus/m2/

# Art sources. The rule inherited from whelp plz and worth keeping: raw and
# regraded captures stay on the machine that made them, and only the
# web-ready files under public/ ever ship. Add the folders back as they
# appear. Anything over a couple of hundred MB belongs in blob storage,
# not here. See docs/STATUS.md §5.
art-sources/
relit-images/
ReLit-WoW-Zone-images/
layered-cities/

# Masters never go in git (see public/journey/README.md), and nothing under
# public/ should be a master, because everything under public/ deploys. Three
# unreferenced ones moved to art-sources/ on 2026-08-25: `Maps/EPL MAP.png`
# (11.3 MB), `brand/tari-mark-source.png` (1.3 MB) and
# `RLextras/RatchetBank.png` (26 MB). Untrack the first two:
#
#   git rm --cached "public/Maps/EPL MAP.png" public/brand/tari-mark-source.png

# Session parking for files on their way out, and python's droppings.
_to_delete/
__pycache__/

# Preview renders from scripts/world-shapes.py. Checking the traced world
# by eye; the shipped artefact is reference/world.json.
.world-check/
